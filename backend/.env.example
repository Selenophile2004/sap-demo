PORT=4000
COMPANY_NAME=شرکت نمونه
PUBLIC_DIR=
DATA_DIR=../fake-data
ETL_OUTPUT_DIR=../fake-data/output
ETL_ENABLED=false
CORS_ORIGIN=http://localhost:5273

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
CEO_USERNAME=demo
CEO_PASSWORD_HASH=replace-with-a-bcrypt-hash
CEO_DISPLAY_NAME=کاربر نمایشی
CEO_DISPLAY_ROLE=مدیرعامل دمو
SINA_USERNAME=guest
SINA_PASSWORD_HASH=replace-with-a-bcrypt-hash
SINA_DISPLAY_NAME=بازدیدکننده
SINA_DISPLAY_ROLE=کاربر دمو

# Provider-neutral AI settings. Leave AI_API_KEY empty for deterministic local mode.
AI_ENABLED=true
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
AI_TIMEOUT_MS=15000

# Legacy Groq names are still accepted for existing deployments:
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
